---
import Layout from "../layouts/Layout.astro";
import Annonce from "../components/Annonce.astro";
---

<Layout>
	<main>
		<Annonce />

		<section class="hero">
			<p class="hero-kicker">
				Portfolio · Électronique · Embarqué · Robotique
			</p>
			<h1>Céleste Koloussa</h1>
			<p class="hero-text">
				Étudiant ingénieur en électronique avancée, je conçois des
				projets en systèmes embarqués, robotique, Linux et développement
				bas niveau.
			</p>

			<div class="hero-actions">
				<a href="/projets" class="button-primary">Voir mes projets</a>
				<a href="/cv" class="button-secondary">Consulter mon CV</a>
			</div>
		</section>

		<section class="section">
			<div class="section-heading">
				<p class="section-kicker">À propos</p>
				<h2>Un profil orienté terrain et conception</h2>
			</div>
			<p class="section-text">
				Je développe des projets mêlant électronique, firmware, ROS,
				Linux et intégration système. Mon objectif est de rejoindre une
				alternance où je peux contribuer sur des sujets concrets :
				cartes électroniques, microcontrôleurs, outils de validation,
				robotique ou systèmes embarqués.
			</p>
		</section>

		<section class="section">
			<div class="section-heading">
				<p class="section-kicker">Projets sélectionnés</p>
				<h2>Quelques réalisations représentatives</h2>
			</div>

			<div class="project-grid">
				<article class="project-card">
					<p class="project-type">Robotique</p>
					<h3>Voiture autonome ROS</h3>
					<p>
						Développement d’une plateforme autonome avec capteurs,
						LIDAR et traitement embarqué pour la navigation.
					</p>
					<a href="/projets">Voir le projet</a>
				</article>

				<article class="project-card">
					<p class="project-type">Bas niveau</p>
					<h3>Processeur RISC-V sur FPGA</h3>
					<p>
						Conception en VHDL sous Vivado avec intégration d’un
						affichage VGA et d’un projet type jeu Pong.
					</p>
					<a href="/projets">Voir le projet</a>
				</article>

				<article class="project-card">
					<p class="project-type">Embarqué</p>
					<h3>Programmation microcontrôleurs</h3>
					<p>
						Développement en C/C++, RTOS, validation de cartes et
						outils autour de plateformes embarquées.
					</p>
					<a href="/projets">Voir le projet</a>
				</article>
			</div>
		</section>

		<section class="section">
			<div class="section-heading">
				<p class="section-kicker">Compétences</p>
				<h2>Domaines que je travaille</h2>
			</div>

			<ul class="skills-list">
				<li>Systèmes embarqués</li>
				<li>Microcontrôleurs C/C++</li>
				<li>VHDL / FPGA</li>
				<li>ROS / robotique</li>
				<li>Linux / administration système</li>
				<li>KiCad / conception électronique</li>
				<li>Python / outils techniques</li>
				<li>Validation et debug matériel</li>
			</ul>
		</section>

		<section class="section timeline">
			<div class="section-heading">
				<p class="section-kicker">Parcours</p>
				<h2>Formation et expérience</h2>
			</div>

			<div class="timeline-list">
				<article class="timeline-item">
					<p class="timeline-date">2026 – 2029</p>
					<h3>EPF ESTI Saint-Nazaire</h3>
					<p>Diplôme d’ingénieur, option Électronique Avancée.</p>
				</article>

				<article class="timeline-item">
					<p class="timeline-date">2025</p>
					<h3>Stage — LABAA</h3>
					<p>
						Développement d’outils de programmation et validation de
						cartes, analyse de bugs et amélioration firmware.
					</p>
				</article>

				<article class="timeline-item">
					<p class="timeline-date">2022 – 2025</p>
					<h3>BUT GEII — IUT de Nantes</h3>
					<p>
						Formation orientée électronique, systèmes numériques,
						embarqué et informatique industrielle.
					</p>
				</article>
			</div>
		</section>

		<section class="section cta">
			<div class="section-heading">
				<p class="section-kicker">Contact</p>
				<h2>
					Disponible pour une alternance à partir de septembre 2026
				</h2>
			</div>
			<p class="section-text">
				Je recherche une opportunité en électronique embarquée, systèmes
				embarqués, robotique ou informatique industrielle.
			</p>

			<div class="hero-actions">
				<a href="/contact" class="button-primary">Me contacter</a>
				<a href="/cv" class="button-secondary">Télécharger mon CV</a>
			</div>
		</section>
	</main>
</Layout>
