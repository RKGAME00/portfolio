# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Ressources originales volumineuses, conservées uniquement en local
/ressources-locales/
/port folio/

# Inventaire local détaillé des déplacements (noms des fichiers personnels)
/archives/inventaire-local-*.json

# Téléchargements incomplets : conserver sur disque, exclure de Git
*.crdownload
*.part

# Nouveau site Next.js : sorties, configuration locale et caches
.next/
out/
*.tsbuildinfo
.env*.local

# Inventaire privé et extractions locales des archives (originaux conservés)
/.cache/

# Vue locale par bloc : liens vers les originaux volumineux, jamais dupliqués dans Git.
/contenus/**/ressources/
/contenus/**/originaux
/contenus/**/inventaire-local.json
/contenus/**/inventaire-local-*.json

# Sélection LABAA mise de côté, sans suppression des originaux
/contenus/**/a-trier/
# Garder le manifeste de conservation, sans versionner ses médias.
!/contenus/a-trier/
!/contenus/a-trier/archives-portfolio/
!/contenus/a-trier/archives-portfolio/ressources.json
